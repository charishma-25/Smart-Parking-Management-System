<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <div class="container navbar">
        <a class="brand" href="/"><div class="brand-mark">P</div><span>park<span class="brand-light">wise</span></span></a>
        <nav class="nav-links">
          <a href="/user/dashboard">Dashboard</a>
          <a href="/find-parking">Find Parking</a>
          <a href="/reservations">Reservations</a>
          <a href="/notifications">Notifications</a>
          <a href="/profile">Profile</a>
          <a href="/logout" class="link-button">Logout</a>
        </nav>
      </div>
    </header>

    <section class="page-header">
      <div class="container">
        <h1>Welcome, <%= user.name %></h1>
      </div>
    </section>

    <main class="container page-panel">
      <div class="summary-grid">
        <div class="metric-card">
          <span>Nearby areas</span>
          <strong><%= stats.nearbyAreas %></strong>
        </div>
        <div class="metric-card">
          <span>Open slots</span>
          <strong><%= stats.openSlots %></strong>
        </div>
        <div class="metric-card">
          <span>Upcoming reservations</span>
          <strong><%= stats.upcomingReservations %></strong>
        </div>
        <div class="metric-card">
          <span>Total spent</span>
          <strong><%= toMoney(stats.totalSpent) %></strong>
        </div>
      </div>

      <div class="dashboard-grid" style="margin-bottom: 24px;">
        <div class="dashboard-card">
          <h3>Nearby Parking Areas</h3>
          <ul>
            <% areas.forEach((area) => { %>
              <li><strong><%= area.name %></strong> — <%= area.location %> — <%= toMoney(area.hourly_rate) %>/hour</li>
            <% }) %>
          </ul>
        </div>
        <div class="dashboard-card">
          <h3>Recent Payments</h3>
          <% if (!payments.length) { %>
            <p>No recent payments.</p>
          <% } else { %>
            <ul>
              <% payments.forEach((payment) => { %>
                <li><%= payment.reservation_code %> — <%= toMoney(payment.amount) %> — <span class="status-badge status-paid"><%= payment.status %></span></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>

      <div class="dashboard-grid">
        <div class="dashboard-card">
          <h3>Upcoming Reservations</h3>
          <% if (!reservations.length) { %>
            <p>No bookings yet.</p>
          <% } else { %>
            <ul>
              <% reservations.forEach((reservation) => { %>
                <li><strong><%= reservation.area_name %></strong> — <%= reservation.slot_number %> — <span class="status-badge status-confirmed"><%= reservation.status %></span></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
        <div class="dashboard-card">
          <h3>Notifications</h3>
          <% if (!notifications.length) { %>
            <p>No new messages.</p>
          <% } else { %>
            <ul>
              <% notifications.forEach((item) => { %>
                <li><strong><%= item.title %></strong> — <%= item.message %></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    </main>
  </body>
</html>
