<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <div class="container navbar">
        <a class="brand" href="/"><div class="brand-mark">P</div><span>park<span class="brand-light">wise</span></span></a>
        <nav class="nav-links">
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/areas">Areas</a>
          <a href="/admin/slots">Slots</a>
          <a href="/admin/occupancy">Occupancy</a>
          <a href="/admin/reservations">Reservations</a>
          <a href="/admin/payments">Payments</a>
          <a href="/admin/reports">Reports</a>
          <a href="/logout" class="link-button">Logout</a>
        </nav>
      </div>
    </header>

    <section class="page-header">
      <div class="container"><h1>Administrator dashboard</h1></div>
    </section>

    <main class="container page-panel">
      <div class="summary-grid">
        <div class="metric-card"><span>Total areas</span><strong><%= metrics.areaTotal %></strong></div>
        <div class="metric-card"><span>Total slots</span><strong><%= metrics.slotTotal %></strong></div>
        <div class="metric-card"><span>Reservations</span><strong><%= metrics.reservationTotal %></strong></div>
        <div class="metric-card"><span>Revenue</span><strong><%= toMoney(metrics.paymentTotal) %></strong></div>
      </div>

      <div class="dashboard-grid">
        <div class="dashboard-card">
          <h3>Operating areas</h3>
          <% areas.forEach((area) => { %>
            <p><strong><%= area.name %></strong> — <%= area.location %></p>
          <% }) %>
        </div>
        <div class="dashboard-card">
          <h3>Recent reservations</h3>
          <% reservations.forEach((reservation) => { %>
            <p><strong><%= reservation.user_name %></strong> booked <%= reservation.area_name %> slot <%= reservation.slot_number %> for <span class="status-badge status-confirmed"><%= reservation.status %></span></p>
          <% }) %>
        </div>
      </div>
    </main>
  </body>
</html>
