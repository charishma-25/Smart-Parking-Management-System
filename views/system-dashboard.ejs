<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <div class="container navbar">
        <a class="brand" href="/"><div class="brand-mark">P</div><span>park<span class="brand-light">wise</span></span></a>
        <nav class="nav-links">
          <a href="/system/dashboard">Dashboard</a>
          <a href="/system/users">Users</a>
          <a href="/system/admins">Administrators</a>
          <a href="/system/config">Config</a>
          <a href="/logout" class="link-button">Logout</a>
        </nav>
      </div>
    </header>

    <section class="page-header">
      <div class="container"><h1>System dashboard</h1></div>
    </section>

    <main class="container page-panel">
      <div class="summary-grid">
        <div class="metric-card"><span>Users</span><strong><%= metrics.user_count %></strong></div>
        <div class="metric-card"><span>Admins</span><strong><%= metrics.admin_count %></strong></div>
        <div class="metric-card"><span>Areas</span><strong><%= metrics.area_count %></strong></div>
        <div class="metric-card"><span>Revenue</span><strong><%= toMoney(metrics.total_revenue) %></strong></div>
      </div>
    </main>
  </body>
</html>
