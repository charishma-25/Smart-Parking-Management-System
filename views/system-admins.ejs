<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <div class="container navbar">
        <a class="brand" href="/"><div class="brand-mark">P</div><span>park<span class="brand-light">wise</span></span></a>
        <nav class="nav-links">
          <a href="/system/dashboard">Dashboard</a>
          <a href="/system/users">Users</a>
          <a href="/system/admins">Administrators</a>
          <a href="/system/config">Config</a>
          <a href="/logout" class="link-button">Logout</a>
        </nav>
      </div>
    </header>

    <section class="page-header">
      <div class="container"><h1>Administrator management</h1></div>
    </section>

    <main class="container page-panel">
      <div class="list-card">
        <table>
          <thead>
            <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% admins.forEach((account) => { %>
              <tr>
                <td><%= account.name %></td>
                <td><%= account.email %></td>
                <td><%= account.role %></td>
                <td><span class="status-badge status-confirmed"><%= account.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>
