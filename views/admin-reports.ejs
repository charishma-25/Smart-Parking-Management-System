<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <div class="container navbar">
        <a class="brand" href="/"><div class="brand-mark">P</div><span>park<span class="brand-light">wise</span></span></a>
        <nav class="nav-links">
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/areas">Areas</a>
          <a href="/admin/slots">Slots</a>
          <a href="/admin/occupancy">Occupancy</a>
          <a href="/admin/reservations">Reservations</a>
          <a href="/admin/payments">Payments</a>
          <a href="/admin/reports">Reports</a>
          <a href="/logout" class="link-button">Logout</a>
        </nav>
      </div>
    </header>

    <section class="page-header">
      <div class="container"><h1>Parking reports</h1></div>
    </section>

    <main class="container page-panel">
      <div class="summary-grid">
        <% areas.forEach((area) => { %>
          <div class="metric-card">
            <span><%= area.name %></span>
            <strong><%= area.total_slots %></strong>
          </div>
        <% }) %>
      </div>

      <div class="list-card">
        <table>
          <thead>
            <tr><th>Payment reference</th><th>Amount</th><th>Date</th></tr>
          </thead>
          <tbody>
            <% payments.forEach((payment) => { %>
              <tr>
                <td><%= payment.transaction_reference %></td>
                <td><%= toMoney(payment.amount) %></td>
                <td><%= new Date(payment.created_at).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>
